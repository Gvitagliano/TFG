\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces 4H-SiC Positive layout used for the wet etching process. The layout includes four $\lambda /4$ CPW resonators, inductively coupled to the central feedline. Launchers are added at each end of the feedline to facilitate wire-bonding. Each resonator can be seen to have distinct total lengths and distancing from the feedline. The colored areas protect the Al film, while the white gaps let the etchant through to generate the pattern.}}{26}{figure.caption.18}\protected@file@percent }
\newlabel{fig:PositiveResist}{{10}{26}{4H-SiC Positive layout used for the wet etching process. The layout includes four $\lambda /4$ CPW resonators, inductively coupled to the central feedline. Launchers are added at each end of the feedline to facilitate wire-bonding. Each resonator can be seen to have distinct total lengths and distancing from the feedline. The colored areas protect the Al film, while the white gaps let the etchant through to generate the pattern}{figure.caption.18}{}}
\newlabel{fig:PositiveResist@cref}{{[figure][10][]10}{[1][25][]26}{}{}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.2}Fabrication results}{26}{subsubsection.3.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces 4H-SiC Negative layout used for the lift-off process. This layout is the complementary (inverted) pattern to the positive mask. The colored regions of the resist become insoluble as they are exposed to the laser, protecting those areas from Al evaporation. Then the resist is removed leaving the pattern behind.}}{27}{figure.caption.19}\protected@file@percent }
\newlabel{fig:NegativeResist}{{11}{27}{4H-SiC Negative layout used for the lift-off process. This layout is the complementary (inverted) pattern to the positive mask. The colored regions of the resist become insoluble as they are exposed to the laser, protecting those areas from Al evaporation. Then the resist is removed leaving the pattern behind}{figure.caption.19}{}}
\newlabel{fig:NegativeResist@cref}{{[figure][11][]11}{[1][25][]27}{}{}{}}
