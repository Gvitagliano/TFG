}

@article{Canonica2020a,
  title = {Operation of a {{Diamond Cryogenic Detector}} for {{Low-Mass Dark Matter Searches}}},
  author = {Canonica, L. and Abdelhameed, A. H. and Bauer, P. and Bento, A. and Bertoldo, E. and Ferreiro Iachellini, N. and Fuchs, D. and Hauff, D. and Mancuso, M. and Petricca, F. and Pr{\"o}bst, F. and Rothe, J.},
  year = 2020,
